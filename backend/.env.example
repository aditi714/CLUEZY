# ==============================================================================
# CLUEZY Backend Environment Configuration
# ==============================================================================
# Application Settings
APP_ENV=development
DEBUG=true
PROJECT_NAME="CLUEZY Backend API"
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://cluezy.vercel.app"]

# Supabase PostgreSQL Database Connectivity (Session Pooler recommended for IPv4)
# Async connection for FastAPI (SQLAlchemy asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[[YOUR-PASSWORD]]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Sync connection for Alembic migrations
DATABASE_URL_SYNC=postgresql://postgres.[YOUR-PROJECT-REF]:[[YOUR-PASSWORD]]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Groq AI Model Configuration
# Primary model approved: openai/gpt-oss-120b
GROQ_API_KEY=gsk_[YOUR-GROQ-API-KEY-HERE]
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2

# Anonymous Session Configuration
ANONYMOUS_SESSION_TTL_HOURS=720
DAILY_TOKEN_LIMIT=200000
